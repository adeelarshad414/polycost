{
  "name": "polycost",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "npm ci && npm run hooks:install",
    "dev": "docker compose up --build",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "api:dev": "npm run start:dev --workspace @polycost/api",
    "web:dev": "npm run dev --workspace @polycost/web",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:seed": "node scripts/db.mjs seed",
    "db:reset": "node scripts/db.mjs reset",
    "db:validate": "node scripts/db.mjs validate",
    "graphify": "node scripts/graphify-local.mjs build",
    "graphify:validate": "node scripts/graphify-local.mjs validate",
    "graphify:visualize": "node scripts/graphify-local.mjs visualize",
    "graphify:tool": "graphify --help",
    "impeccable": "node scripts/impeccable-check.mjs",
    "caveman": "node scripts/caveman.mjs help",
    "caveman:setup": "node scripts/caveman.mjs setup",
    "caveman:dev": "node scripts/caveman.mjs dev",
    "caveman:doctor": "node scripts/caveman.mjs doctor",
    "caveman:full": "node scripts/caveman.mjs full",
    "caveman:db": "node scripts/caveman.mjs db",
    "qa": "node scripts/qa-check.mjs && npm run impeccable",
    "devops:check": "node scripts/devops-check.mjs",
    "cloud:check": "node scripts/cloud-check.mjs",
    "provider:credentials:check": "node scripts/provider-credential-check.mjs",
    "provider:credentials:check:strict": "node scripts/provider-credential-check.mjs --strict",
    "demo:up": "node scripts/demo-ready.mjs",
    "demo:artifacts": "node scripts/capture-demo-artifacts.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "security:audit": "npm audit --audit-level=high",
    "security:secrets": "gitleaks detect --source . --no-git --redact",
    "security:containers": "trivy fs --exit-code 1 --severity HIGH,CRITICAL .",
    "security:scan": "npm run security:secrets && npm run security:containers",
    "check": "npm run format:check && npm run ci:lint && npm run test:unit && npm run graphify:validate && npm run qa && npm run db:validate && npm run devops:check && npm run cloud:check",
    "check:full": "npm run check && npm run ci:unit && npm run ci:integration && npm run ci:build && npm run ci:e2e && npm run ci:security && npm run security:scan",
    "ci:lint": "npm run lint && npm run typecheck",
    "ci:unit": "npm run test:coverage",
    "ci:integration": "npm run test:integration",
    "ci:build": "npm run build",
    "ci:e2e": "node scripts/ci-e2e.mjs",
    "ci:security": "npm run security:audit"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@sentropic/graphify": "^0.17.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "eslint-plugin-security": "^3.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "@google-cloud/opentelemetry-resource-util": "^3.0.0",
    "@nestjs/common": "^11.1.27",
    "@opentelemetry/core": "^2.9.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "gaxios": "^7.1.5",
    "gcp-metadata": "^8.1.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
