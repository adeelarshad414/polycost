{
  "name": "polycost",
  "version": "0.1.0",
  "description": "Open-source, self-hostable multi-cloud cost comparison for AWS, Azure, and GCP.",
  "license": "MIT",
  "private": true,
  "author": "Adeel Arshad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adeelarshad414/polycost.git"
  },
  "bugs": {
    "url": "https://github.com/adeelarshad414/polycost/issues"
  },
  "homepage": "https://github.com/adeelarshad414/polycost#readme",
  "keywords": [
    "aws",
    "azure",
    "cloud-cost",
    "finops",
    "gcp",
    "multi-cloud",
    "pricing",
    "self-hosted"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "npm ci && npm run hooks:install",
    "dev": "docker compose up --build",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:production-readiness": "npm run test:unit --workspace @polycost/api -- --runInBand src/api/finops-proof.spec.ts src/pricing-normalization/pricing-reconciliation.spec.ts src/api/live-pricing-traceability.spec.ts src/api/auth-billing.spec.ts src/api/auth.controller.spec.ts src/api/api-contract.spec.ts src/terraform/terraform-generation.service.spec.ts src/diagram-parser/diagram-parser.service.spec.ts src/diagram-parser/llm-classifier.client.spec.ts src/reports/report-generators.spec.ts && npm run test:unit --workspace @polycost/web -- --runInBand src/App.spec.tsx src/api-client.spec.ts",
    "build": "npm run build --workspaces --if-present",
    "api:dev": "npm run start:dev --workspace @polycost/api",
    "web:dev": "npm run dev --workspace @polycost/web",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:seed": "node scripts/db.mjs seed",
    "db:reset": "node scripts/db.mjs reset",
    "db:validate": "node scripts/db.mjs validate",
    "graphify": "node scripts/graphify-local.mjs build",
    "graphify:validate": "node scripts/graphify-local.mjs validate",
    "graphify:visualize": "node scripts/graphify-local.mjs visualize",
    "graphify:tool": "graphify --help",
    "pricing:coverage:check": "node scripts/pricing-service-coverage-check.mjs",
    "pricing:logic:coverage": "node scripts/pricing-logic-coverage-check.mjs",
    "progress:verify": "node scripts/full-progress-verification-check.mjs",
    "loading:check": "node scripts/loading-experience-check.mjs",
    "theme:hex:check": "node scripts/theme-hex-guard.mjs",
    "overlay:check": "node scripts/overlay-button-check.mjs",
    "impeccable": "node scripts/impeccable-check.mjs",
    "caveman": "node scripts/caveman.mjs help",
    "caveman:setup": "node scripts/caveman.mjs setup",
    "caveman:dev": "node scripts/caveman.mjs dev",
    "caveman:doctor": "node scripts/caveman.mjs doctor",
    "caveman:full": "node scripts/caveman.mjs full",
    "caveman:db": "node scripts/caveman.mjs db",
    "qa": "node scripts/qa-check.mjs && npm run security:suppressions && npm run impeccable",
    "devops:check": "node scripts/devops-check.mjs",
    "cloud:check": "node scripts/cloud-check.mjs",
    "release:check": "node scripts/release-readiness-check.mjs",
    "handover:check": "node scripts/customer-handover-check.mjs",
    "public:readiness:check": "node scripts/public-readiness-check.mjs",
    "provider:credentials:check": "node scripts/provider-credential-check.mjs",
    "provider:credentials:check:strict": "node scripts/provider-credential-check.mjs --strict",
    "demo:up": "node scripts/demo-ready.mjs",
    "demo:artifacts": "node scripts/capture-demo-artifacts.mjs",
    "demo:verify-clean": "node scripts/clean-clone-demo-check.mjs",
    "browser:audit": "node scripts/browser-audit.mjs",
    "live:verify": "node scripts/live-verification.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "security:audit": "npm audit --audit-level=high",
    "security:suppressions": "node scripts/security-suppression-check.mjs",
    "security:secrets": "gitleaks detect --source . --no-git --redact",
    "security:containers": "trivy fs --exit-code 1 --severity HIGH,CRITICAL .",
    "security:scan": "npm run security:secrets && npm run security:containers",
    "check": "npm run format:check && npm run ci:lint && npm run theme:hex:check && npm run loading:check && npm run overlay:check && npm run public:readiness:check && npm run test:unit && npm run graphify:validate && npm run pricing:coverage:check && npm run progress:verify && npm run qa && npm run db:validate && npm run devops:check && npm run cloud:check && npm run release:check && npm run handover:check && npm run provider:credentials:check",
    "check:full": "npm run check && npm run ci:unit && npm run ci:integration && npm run ci:build && npm run ci:e2e && npm run ci:security && npm run security:scan",
    "ci:lint": "npm run lint && npm run typecheck",
    "ci:unit": "npm run test:coverage && npm run pricing:logic:coverage",
    "ci:integration": "npm run test:integration",
    "ci:build": "npm run build",
    "ci:e2e": "node scripts/ci-e2e.mjs",
    "ci:security": "npm run security:audit"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@sentropic/graphify": "^0.17.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.5",
    "axe-core": "^4.12.1",
    "eslint": "^10.6.0",
    "eslint-plugin-security": "^4.0.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lighthouse": "^12.8.2",
    "prettier": "^3.9.4",
    "ts-jest": "^29.4.11",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.62.1"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "@google-cloud/opentelemetry-resource-util": "^3.0.0",
    "@nestjs/common": "^11.1.27",
    "@opentelemetry/core": "^2.9.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "gaxios": "^7.1.5",
    "gcp-metadata": "^8.1.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
