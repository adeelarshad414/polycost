{
  "name": "@polycost/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --host 0.0.0.0",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -b --noEmit",
    "test": "jest --config jest.config.cjs --passWithNoTests",
    "test:unit": "jest --config jest.config.cjs --passWithNoTests",
    "test:component": "jest --config jest.config.cjs --passWithNoTests",
    "test:integration": "jest --config jest.config.cjs --runInBand --testMatch \"**/*.integration.spec.{ts,tsx}\" --passWithNoTests",
    "test:e2e": "jest --config jest.config.cjs --runInBand --testMatch \"**/*.e2e.spec.{ts,tsx}\" --passWithNoTests",
    "test:coverage": "jest --config jest.config.cjs --coverage --passWithNoTests"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.9.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5"
  }
}
