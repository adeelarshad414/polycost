{
  "name": "@polycost/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --host 0.0.0.0",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"playwright.config.ts\" && stylelint \"src/**/*.css\"",
    "typecheck": "tsc -b --noEmit",
    "test": "jest --config jest.config.cjs --passWithNoTests",
    "test:unit": "jest --config jest.config.cjs --passWithNoTests",
    "test:component": "jest --config jest.config.cjs --passWithNoTests",
    "test:integration": "jest --config jest.config.cjs --runInBand --testMatch \"**/*.integration.spec.{ts,tsx}\" --passWithNoTests",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:coverage": "jest --config jest.config.cjs --coverage --passWithNoTests",
    "test:visual": "POLYCOST_VISUAL=1 playwright test",
    "test:visual:update": "POLYCOST_VISUAL=1 playwright test --update-snapshots"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@polycost/types": "0.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^1.49.0",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jest-axe": "^11.0.0",
    "stylelint": "^17.16.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "vite": "^8.3.2"
  }
}
