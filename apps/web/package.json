{
  "name": "@polycost/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --host 0.0.0.0",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"playwright.config.ts\"",
    "typecheck": "tsc -b --noEmit",
    "test": "jest --config jest.config.cjs --passWithNoTests",
    "test:unit": "jest --config jest.config.cjs --passWithNoTests",
    "test:component": "jest --config jest.config.cjs --passWithNoTests",
    "test:integration": "jest --config jest.config.cjs --runInBand --testMatch \"**/*.integration.spec.{ts,tsx}\" --passWithNoTests",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:coverage": "jest --config jest.config.cjs --coverage --passWithNoTests"
  },
  "dependencies": {
    "@polycost/types": "0.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.16",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "vite": "^8.1.4"
  }
}
