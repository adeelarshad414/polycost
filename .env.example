NODE_ENV=development
LOG_LEVEL=debug

API_PORT=3001
WEB_PORT=3000
VITE_API_BASE_URL=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3002

DB_HOST=postgres
DB_PORT=5432
DB_NAME=polycost_dev

REDIS_HOST=redis
REDIS_PORT=6379

VAULT_ADDR=http://vault:8200
VAULT_TOKEN_FILE=/run/polycost-vault-auth/token

PRICING_ETL_SCHEDULE_CRON="0 2 * * *"
CURRENCY_SYNC_SCHEDULE_CRON="0 * * * *"
ALERT_EVALUATOR_SCHEDULE_CRON="*/15 * * * *"
SHARE_LINK_CLEANUP_SCHEDULE_CRON="0 3 * * *"
EXCHANGE_RATE_API_URL=https://api.frankfurter.app/latest
EXCHANGE_RATE_TARGET_CURRENCIES=EUR,GBP,CAD,AUD,PKR,INR,JPY
PRICING_ETL_DEFAULT_REGION_AWS=us-east-1
PRICING_ETL_DEFAULT_REGION_AZURE=eastus
PRICING_ETL_DEFAULT_REGION_GCP=us-central1

RATE_LIMIT_NL_PARSE_PER_MINUTE=10
RATE_LIMIT_LIVE_REFRESH_PER_MINUTE=5
NL_PARSE_MAX_INPUT_CHARS=4000
# LLM_PARSE_ENDPOINT=https://api.example.com/v1/chat/completions
# LLM_PARSE_MODEL=configure-provider-model-name
FEATURE_LIVE_PRICING_REFRESH_ENABLED=true
FEATURE_RESERVED_PRICING=true
