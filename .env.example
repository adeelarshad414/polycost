NODE_ENV=development
LOG_LEVEL=debug

API_PORT=3001
API_HOST_PORT=3001
PORT=3001
WEB_PORT=3000
VITE_API_BASE_URL=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3002

DB_HOST=postgres
DB_PORT=5432
DB_NAME=polycost_dev

REDIS_HOST=redis
REDIS_PORT=6379

VAULT_ADDR=http://vault:8200
VAULT_TOKEN_FILE=/run/polycost-vault-auth/token
# Optional for Vault Enterprise namespaces.
# VAULT_NAMESPACE=admin/polycost

PRICING_ETL_SCHEDULE_CRON="0 2 * * *"
CURRENCY_SYNC_SCHEDULE_CRON="0 * * * *"
ALERT_EVALUATOR_SCHEDULE_CRON="*/15 * * * *"
SHARE_LINK_CLEANUP_SCHEDULE_CRON="0 3 * * *"
# Optional Slack/email bridge/webhook for pricing-sync failure alerts.
# PRICING_SYNC_ALERT_WEBHOOK_URL=https://hooks.example.com/polycost-pricing-sync
EXCHANGE_RATE_API_URL=https://api.frankfurter.app/latest
EXCHANGE_RATE_TARGET_CURRENCIES=EUR,GBP,CAD,AUD,PKR,INR,JPY
PRICING_ETL_DEFAULT_REGION_AWS=us-east-1
PRICING_ETL_DEFAULT_REGION_AZURE=eastus
PRICING_ETL_DEFAULT_REGION_GCP=us-central1
# Development defaults use deterministic mock cloud providers so missing cloud
# credentials never block boot, health checks, or demo comparisons.
USE_MOCK_PROVIDERS=true
PRICING_ETL_RUN_ON_BOOT=true
# Real provider rehearsals:
# USE_MOCK_PROVIDERS=false
# PRICING_ETL_RUN_ON_BOOT=false
# Store provider secrets in Vault. Any CHANGE_ME_DEV_ONLY/dummy values are
# rejected by strict provider checks and by production/staging config validation.

RATE_LIMIT_NL_PARSE_PER_MINUTE=10
RATE_LIMIT_DIAGRAM_PARSE_PER_MINUTE=10
RATE_LIMIT_LIVE_REFRESH_PER_MINUTE=5
RATE_LIMIT_COMPARISON_PER_MINUTE=30
RATE_LIMIT_EXPORT_PER_MINUTE=10
RATE_LIMIT_SHARE_LINK_PER_MINUTE=20
RATE_LIMIT_PUBLIC_READ_PER_MINUTE=60
RATE_LIMIT_PUBLIC_WRITE_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=10
AUTH_SESSION_TTL_HOURS=12
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_LOCAL_REGISTRATION_ENABLED=true
AUTH_PUBLIC_BASE_URL=http://localhost:3001
AUTH_SSO_STATE_SECRET=CHANGE_ME_DEV_ONLY_SSO_STATE_SECRET
# Local/demo invite delivery shows one-time tokens in the workspace panel.
# Staging/production must use webhook mode with an HTTPS URL and signing secret.
AUTH_INVITE_DELIVERY_MODE=panel
# AUTH_INVITE_DELIVERY_MODE=webhook
# AUTH_INVITE_DELIVERY_WEBHOOK_URL=https://mail.example.com/polycost/invites
# AUTH_INVITE_DELIVERY_WEBHOOK_SECRET=CHANGE_ME_DEV_ONLY_INVITE_WEBHOOK_SECRET
# AUTH_INVITE_EMAIL_FROM=PolyCost <noreply@example.com>
# Optional SSO readiness. Store OIDC/SAML secrets in Vault or deployment secret
# manager; these public identifiers only drive status/callback metadata.
# AUTH_OIDC_ISSUER_URL=https://login.example.com
# AUTH_OIDC_CLIENT_ID=polycost
# AUTH_SAML_ENTITY_ID=polycost
# AUTH_SAML_SSO_URL=https://idp.example.com/saml/sso
NL_PARSE_MAX_INPUT_CHARS=4000
# LLM_PARSE_ENDPOINT=https://api.example.com/v1/chat/completions
# LLM_PARSE_MODEL=configure-provider-model-name
# Diagram upload imports are copied to this non-webroot directory with random names
# and are eligible for cleanup after 24 hours.
DIAGRAM_TEMP_DIR=/tmp/polycost-diagram-imports
# Optional Phase 2 Tier-3 classifier hook. If unset, the checked-in deterministic
# stencil/alias classifier is used and unresolved nodes stay reviewable.
# DIAGRAM_LLM_CLASSIFIER_ENDPOINT=https://api.example.com/v1/chat/completions
# DIAGRAM_LLM_CLASSIFIER_MODEL=configure-provider-model-name
# Store the classifier key in Vault at secret/polycost/llm key api_key.
FEATURE_LIVE_PRICING_REFRESH_ENABLED=true
FEATURE_RESERVED_PRICING=true
